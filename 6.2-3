#!/usr/bin/python3
import requests
from bs4 import BeautifulSoup

r = requests.get('http://192.168.56.68:8080/about.html')
soup = BeautifulSoup(r.text, 'html.parser')

rows = soup.find_all('tr')
for row in rows:
    if 'Damian' in row.text or 'Valiant' in row.text:
        print(row)
        print("---")
