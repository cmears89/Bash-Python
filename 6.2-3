#!/usr/bin/python3
import requests
from bs4 import BeautifulSoup

r = requests.get('http://192.168.56.68:8080/about.html')
soup = BeautifulSoup(r.text, 'html.parser')

# Print raw table structure to see all columns
rows = soup.find_all('tr')
for row in rows[:3]:  # just first 3 rows to see structure
    print(row)
    print("---")
