#!/usr/bin/python3
import requests

# Check if there are other about pages
for path in ['/about', '/about/', '/staff', '/employees', '/team', 
             '/about-2', '/about.php', '/staff.html']:
    r = requests.get(f'http://192.168.56.68:8080{path}')
    if r.status_code == 200:
        print(f"FOUND: {path} -> {len(r.text)} bytes")
    else:
        print(f"{path} -> {r.status_code}")
